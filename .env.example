# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma separated list of allowed origins, or * to allow any.
CORS_ORIGIN=*

# ---------------------------------------------------------------------------
# Database (provided by `docker compose up -d db`)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm

# Applied automatically on boot when true. Turn this off when running more
# than one instance so that only the deploy step runs migrations.
RUN_MIGRATIONS_ON_BOOT=true

# ---------------------------------------------------------------------------
# Auth — generate a real secret with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=10

# ---------------------------------------------------------------------------
# Rate limiting on the unauthenticated enquiry form
# ---------------------------------------------------------------------------
PUBLIC_FORM_RATE_WINDOW_MS=600000
PUBLIC_FORM_RATE_MAX=10
